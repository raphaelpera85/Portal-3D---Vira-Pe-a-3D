NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only credentials. Never expose these with the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Legacy Supabase projects may use this until they migrate to a secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase CLI only. Contains the database password; never use as an application or Vercel variable.
SUPABASE_DB_URL=
CRON_SECRET=
# Weekly official catalog-source check: 0=Sunday through 6=Saturday; defaults to Monday.
CATALOG_SOURCE_CHECK_DAY_UTC=1
# Optional comma-separated official source domains to add to the server-side allowlist.
CATALOG_SOURCE_ALLOWED_HOSTS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLOUD_VISION_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# Marketplace commission as a percent of each accepted cart order. Set explicitly (0 is allowed).
MP_MARKETPLACE_FEE_PERCENT=
# 32 random bytes encoded as 64 hexadecimal characters; keep stable to decrypt existing seller tokens.
MP_TOKEN_ENCRYPTION_KEY=
# Melhor Envio OAuth app credentials. Register this exact callback URL in the app.
ME_CLIENT_ID=
ME_CLIENT_SECRET=
# 32 random bytes as 64 hexadecimal characters; used only to encrypt shipping OAuth tokens.
ME_TOKEN_ENCRYPTION_KEY=
# Set true only for a separate Melhor Envio Sandbox app/account.
MELHOR_ENVIO_SANDBOX=false
